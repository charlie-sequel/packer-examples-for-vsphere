/*
    DESCRIPTION:
    Operating system and virtual hardware settings for the Omnissa Horizon golden image.
    Packer Plugin for VMware vSphere: 'vsphere-iso' builder.

    Horizon behavior -- which agents are installed, where the installers come from, how each is
    configured, and how the OS Optimization Tool runs -- lives in one place instead:

        config/horizon.pkrvars.hcl

    This file covers only the operating system, its media, and the virtual hardware.

    Copied to config/windows-horizon-11.pkrvars.hcl by ./config.sh.
*/

// Installation Operating System Metadata
// Set vm_inst_os_eval = false to have the answer file emit a product key. The value below is
// Microsoft's public KMS client key (GVLK) for Windows 11 Pro; the image installs unactivated
// and clones activate against your KMS host. Replace it if you use a different edition or MAK.
vm_inst_os_eval    = false
vm_inst_os_key = "W269N-WFGWX-YVC9B-4J6C9-T83GX"

// Virtual Machine Guest Operating System Setting
vm_guest_os_type = "windows9_64Guest"

// Virtual Machine Hardware Settings
vm_firmware = "efi-secure"

// Removable Media Settings
iso_datastore_path       = "iso/windows/windows-desktop/11/amd64"
iso_content_library_item = "windows-desktop-11"
iso_file                 = "REPLACE-WITH-YOUR-WINDOWS-11-ISO.iso"
