/*
    DESCRIPTION:
    Operating system, media, and virtual hardware for the SDS client connector image.

    What gets installed on it -- the applications, where their installers come from, and how the
    OS Optimization Tool runs -- lives in one place instead:

        config/sds.pkrvars.hcl

    Copied to config/windows-sds-11.pkrvars.hcl by ./config.sh.
*/

// This image lives on its own network segment, not the one the other builds use. Set here rather
// than in config/vsphere.pkrvars.hcl so it applies to this build only; build.sh loads this file
// after the shared one, so this value wins.
vsphere_network = "SDS - VLAN 100"

// Installation Operating System Metadata
// Microsoft's public KMS client key (GVLK) for Windows 11 Pro. The image installs unactivated and
// activates against your KMS host. Replace it for a different edition or a MAK.
vm_inst_os_eval    = false
vm_inst_os_key_pro = "W269N-WFGWX-YVC9B-4J6C9-T83GX"

// Virtual Machine Guest Operating System Setting
vm_guest_os_type = "windows9_64Guest"

// Virtual Machine Hardware Settings
vm_firmware = "efi-secure"

// A connector machine is not a workstation: keep it small.
vm_cpu_count = 4
vm_cpu_cores = 2
vm_mem_size  = 8192
vm_disk_size = 61440

// Removable Media Settings
iso_datastore_path       = "iso/windows/windows-desktop/11/amd64"
iso_content_library_item = "windows-desktop-11"
iso_file                 = "Win11_25H2_English_x64_v2.iso"

// Virtual hardware for multi-monitor sessions.
//
// NOTE THE UNIT: vm_video_ram is in KB, not MB. 128 MB is 131072 KB; the project default of 4096
// is 4 MB, not 4 GB.
vm_video_displays = 4
vm_video_ram      = 131072
